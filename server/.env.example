PORT=4000
NODE_ENV=development

# MongoDB Atlas (mongodb+srv://usuario:password@cluster.mongodb.net/emporio)
# Si lo dejás VACÍO en desarrollo, `npm run dev` levanta una base local automática
# (guardada en server/.devdb) y carga los datos iniciales. En producción es obligatorio.
MONGO_URI=

JWT_SECRET_ADMIN=cambiar-por-un-secreto-largo-admin
JWT_SECRET_CUSTOMER=cambiar-por-un-secreto-largo-cliente

# Una o varias URLs separadas por coma (sin barra final)
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Primer administrador (seed:admin y base local de desarrollo)
ADMIN_EMAIL=admin@elemporio.com
ADMIN_PASSWORD=CambiarEsto123
ADMIN_NAME=Administrador
